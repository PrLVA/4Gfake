<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matrix_bg"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/matrix_bg"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/matrix_bg"
            app:menu="@menu/menu_main"
            app:title=">_ MATRIX CELL GUARD"
            app:titleCentered="false"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/matrix_green" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/matrix_green"
            app:trackColor="@color/matrix_green_dark" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Terminal Status Subheader -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:text="[::] 5G/4G_MODEM_LISTENER // SECURE_SOCKET_OPEN"
                android:textColor="@color/matrix_green_dim"
                android:textSize="11sp" />

            <!-- Permission Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/matrix_amber_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/matrix_amber"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="[!] PERMISOS REQUERIDOS DENEGADOS"
                        android:textColor="@color/matrix_amber"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="Acceso denegado a la interfaz de módem. Se requiere permiso de ubicación y estado para inspeccionar celdas."
                        android:textColor="@color/matrix_amber"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermissions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:text="> HABILITAR PERMISOS"
                        android:textColor="@color/black"
                        app:backgroundTint="@color/matrix_amber" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- GPS / Location Service Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGpsWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/matrix_amber_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/matrix_amber"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="[!] UBICACIÓN (GPS) DESACTIVADA"
                        android:textColor="@color/matrix_amber"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="Android requiere que el GPS esté encendido para escanear antenas vecinas y redes celulares."
                        android:textColor="@color/matrix_amber"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnableGps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:text="> ACTIVAR UBICACIÓN"
                        android:textColor="@color/black"
                        app:backgroundTint="@color/matrix_amber" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Main Security Threat Status Banner (Matrix Style) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThreatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/matrix_green_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/matrix_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivThreatIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="Estado de Seguridad"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="@color/matrix_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvThreatTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="SYSTEM STATUS: SECURE"
                                android:textColor="@color/matrix_green"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvThreatSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="THREAT_INDEX: 0/100"
                                android:textColor="@color/matrix_text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvThreatDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:text="No se detectaron anomalías en la estación base de telefonía."
                        android:textColor="@color/matrix_text_secondary"
                        android:textSize="12sp" />

                    <!-- Buttons Row occupying full width -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartScan"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="monospace"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="[ INICIAR ]"
                            android:textColor="@color/matrix_green"
                            android:textSize="12sp"
                            app:strokeColor="@color/matrix_green" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopScan"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:fontFamily="monospace"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="[ PARAR ]"
                            android:textColor="@color/matrix_red"
                            android:textSize="12sp"
                            app:strokeColor="@color/matrix_red" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Antennas Summary Counter Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/matrix_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/matrix_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="> ANTENAS TOTALES EN RANGO"
                            android:textColor="@color/matrix_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvTotalAntennasCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="1"
                            android:textColor="@color/matrix_green"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="> VECINAS DISPONIBLES"
                            android:textColor="@color/matrix_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvNeighborsCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="0"
                            android:textColor="@color/matrix_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Active Tower Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/matrix_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/matrix_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="> CELDAS_ACTIVAS // PARAMETROS"
                        android:textColor="@color/matrix_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="2"
                        android:rowCount="4">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:fontFamily="monospace"
                            android:text="OPERADOR:"
                            android:textColor="@color/matrix_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCellOperator"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:fontFamily="monospace"
                            android:text="Movistar (214-07)"
                            android:textColor="@color/matrix_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:text="TECNOLOGIA:"
                            android:textColor="@color/matrix_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCellNetworkType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:text="LTE 4G"
                            android:textColor="@color/matrix_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:text="CELL_ID (CID):"
                            android:textColor="@color/matrix_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCellId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:text="20849102"
                            android:textColor="@color/matrix_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:text="AREA (TAC/LAC):"
                            android:textColor="@color/matrix_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCellTac"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:text="18400"
                            android:textColor="@color/matrix_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </GridLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="POTENCIA_SEÑAL:"
                            android:textColor="@color/matrix_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCellSignalDbm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="-82 dBm"
                            android:textColor="@color/matrix_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Detected Security Anomalies Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"
                android:text="> ANOMALIAS // AUDITORIA DE RIESGO"
                android:textColor="@color/matrix_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAnomalies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false" />

            <!-- Neighbor Cell Towers Section -->
            <TextView
                android:id="@+id/tvNeighborsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="monospace"
                android:text="> CELDAS_VECINAS // DETECTADAS (0)"
                android:textColor="@color/matrix_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNeighborsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:text="[i] No se detectaron celdas vecinas secundarias. Solo la antena principal está en rango."
                android:textColor="@color/matrix_text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNeighbors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false" />

            <!-- Historical Log Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="> LOG_CONSOLA // TIEMPO REAL"
                    android:textColor="@color/matrix_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearLogs"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="[ CLEAR ]"
                    android:textColor="@color/matrix_green" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
